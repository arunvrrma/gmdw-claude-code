#!/usr/bin/env python3
"""wf — GMDW workflow CLI. The human's side of the workflow.

Since v0.3.0 the workflow is driven by the deterministic orchestrator
(`python3 -m gmdw.orchestrator run <request>`), not by this CLI and not by a
model. What remains here is what a *person* needs: inspecting a run, recording a
gate decision, and recovering a run whose session lost its governance hooks.

Commands:
  init        create a workflow without driving it (the orchestrator's `run`
              does this for you; use this for CI or a hand-driven run)
  status      show the active workflow's state, counters, budget
  expected    show what artifacts/agent the current state is waiting for
  doctor      read-only preflight: is the enforcement plane wired up and live?
  transition  request a state transition (table + guard validated)
  approve     record a human gate decision as a frozen approval artifact
  accept      human recovery: accept a stranded, validly-produced artifact
  clear-invocation  human recovery: release an orphaned open_invocation
  validate    validate an artifact file against its Markdown contract
  close       finalize a terminal workflow (tamper check, index, clear ACTIVE)

The two recovery commands exist ONLY for a session whose governance hooks are
not firing. While the hooks ARE live the PreToolUse gate denies them — along
with `approve`, which an agent must never run against its own work.

Exit codes: 0 ok, 1 governance rejection / validation failure, 2 usage error.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_FALLBACK_ROOT = _HERE.parent.parent  # repo root when invoked in place
sys.path.insert(0, str(_FALLBACK_ROOT))

from gmdw import __version__ as GMDW_VERSION  # noqa: E402
from gmdw import accept, heartbeat, ledger, parsers  # noqa: E402
from gmdw import state as S               # noqa: E402
from gmdw.state import GmdwError          # noqa: E402

# Transitions that must stay reachable when the enforcement plane is dark:
# they are how a stuck or ungoverned workflow is abandoned or handed to a human.
LIVENESS_EXEMPT_STATES = ("ESCALATED", "FAILED", "REJECTED")

# The canonical bypass env var (ADR-001). Read with an AFFIRMATIVE-ONLY check:
# a bypass that treats GMDW_ALLOW_UNGOVERNED=0 as "on" would silently disable
# governance on a stray assignment, which is the wrong way for this to fail.
_AFFIRMATIVE = {"1", "true", "yes", "on"}

# Gates a human can record here, and what each one signs.
GATES = ["plan", "final", "architecture", "deployment", "escalation",
         "route_downgrade"]


def _affirmative(value: str | None) -> bool:
    return (value or "").strip().lower() in _AFFIRMATIVE


def _root():
    try:
        return S.find_root(os.getcwd())
    except GmdwError:
        return _FALLBACK_ROOT


def _die(msg: str, code: int = 1):
    print(f"wf: error: {msg}", file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------- #

def cmd_init(a):
    root = _root()
    if a.request == "-":
        text = sys.stdin.read()
    else:
        p = Path(a.request)
        if not p.exists():
            _die(f"request file not found: {a.request}", 2)
        text = p.read_text(encoding="utf-8")
    if not text.strip():
        _die("request is empty", 2)
    title = a.title or text.strip().splitlines()[0][:120]

    # Governance-liveness preflight. GMDW's guarantees are enforced by hooks that
    # exist only when Claude Code loaded THIS project's settings. Two checks,
    # either sufficient: the hooks are wired up (which is what the orchestrator
    # verifies, since it starts outside any session), or one has fired recently
    # in this session (the in-session self-attestation).
    installed, why_installed = heartbeat.enforcement_installed(root)
    live, why_live = heartbeat.status(root)
    governed = installed or live
    why = why_installed if not installed else why_live
    bypass = (os.environ.get("GMDW_ALLOW_UNGOVERNED_INIT") or
              _affirmative(os.environ.get("GMDW_ALLOW_UNGOVERNED")))
    if not governed and not bypass:
        _die("the GMDW enforcement plane is not available — refusing to start a "
             "workflow.\n"
             f"  reason: {why}\n"
             "  Enforcement (write-scoping, protected paths, artifact acceptance,\n"
             "  the push gate) is provided by hooks registered in this project's\n"
             "  .claude/settings.json and running inside each agent session.\n"
             "  Launch from gmdw-claude-code as the project root and retry.\n"
             "  For legitimate non-Claude use (CI, manual ops) set\n"
             "  GMDW_ALLOW_UNGOVERNED=1 to override (recorded in the ledger).")

    try:
        wf_id = S.create_workflow(root, text, title, a.by, a.profile,
                                  auto_approve=a.auto_approve)
    except GmdwError as e:
        _die(str(e))

    if not governed:  # bypass was set: record the ungoverned start in the trail
        ledger.log(root, wf_id, "governance_liveness_bypassed", reason=why,
                   by=a.by, phase="init")
        print(f"wf: warning: {why}; proceeding under GMDW_ALLOW_UNGOVERNED "
              f"(recorded in the ledger)", file=sys.stderr)
    if a.auto_approve:
        ledger.log(root, wf_id, "auto_approve_enabled", by=a.by,
                   gates=["plan", "final"])

    print(json.dumps({"workflow_id": wf_id, "state": "RECEIVED",
                      "run_dir": f".workflow/runs/{wf_id}",
                      "next": "python3 -m gmdw.orchestrator resume"}))


def cmd_status(a):
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    out = {
        "workflow_id": wf_id,
        "title": st["workflow"]["title"],
        "state": st["state"],
        "route": st["route"],
        "flags": st["flags"],
        "counters": st["counters"],
        "limits": st["limits"],
        "budget": st["budget"],
        "current": st["current"],
        "human_approved": st.get("human_approved"),
        "auto_approve": st.get("auto_approve"),
        "approvals": [{k: v for k, v in ap.items() if k != "notes"}
                      for ap in st["approvals"]],
        "escalations": st["escalations"],
        "open_invocation": st["open_invocation"],
        "policy_profile": st["policy"]["profile_name"],
        "awaiting_gate": S.GATE_FOR_STATE.get(st["state"]),
    }
    print(json.dumps(out, indent=None if a.json else 2))


def cmd_expected(a):
    root = _root()
    try:
        _, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    exp = S.expected(root, st)
    if exp is None:
        gate = S.GATE_FOR_STATE.get(st["state"])
        print(json.dumps({
            "state": st["state"], "expected": None,
            "note": (f"no artifact is produced in this state; it is waiting on "
                     f"the '{gate}' human gate" if gate else
                     "no artifact is produced in this state")}))
    else:
        print(json.dumps(exp, indent=2))


def cmd_doctor(a):
    """Read-only preflight: is the GMDW enforcement plane wired up, and is it
    live in THIS session? Creates and mutates NOTHING, so it is safe to run
    anytime, including before `init`.

    Two independent readings. *Installed* is static: the three hooks are
    registered in .claude/settings.json and present on disk — this is what the
    deterministic orchestrator checks, since it starts before any session exists.
    *Live* is dynamic self-attestation: run via Bash inside a governed session,
    the PreToolUse gate fires on that very Bash call and refreshes the heartbeat
    immediately before this reads it.

    Exit 0 when the plane is usable (installed, or live), 1 when it is not.
    """
    root = _root()
    installed, why_installed = heartbeat.enforcement_installed(root)
    live, why_live = heartbeat.status(root)
    active = S.active_id(root)
    usable = installed or live
    if a.json:
        print(json.dumps({"hooks_installed": installed,
                          "hooks_live": live, "usable": usable,
                          "reason": why_installed if not installed else why_live,
                          "active_workflow": active}))
    else:
        print("✅ enforcement hooks are REGISTERED" if installed
              else "❌ enforcement hooks are NOT registered")
        print(f"   {why_installed}")
        print("✅ enforcement hooks are LIVE in this session" if live
              else "⚠  no fresh hook heartbeat in this session")
        print(f"   {why_live}")
        print(f"   active workflow: {active or 'none'}")
        if not usable:
            print("   → you are likely not rooted in the gmdw-claude-code project. "
                  "Launch Claude Code with this repo as the project root "
                  "(see docs/GETTING_STARTED.md), then retry.")
    sys.exit(0 if usable else 1)


def _liveness_preflight(root, a):
    """Refuse a mid-run transition when the enforcement plane is dark.

    `init` proves the plane was available when a workflow STARTED, but the
    session can lose it afterwards (a resumed run, a session rooted elsewhere, a
    settings change) — and from then on nothing scopes writes or gates pushes,
    while `wf` happily keeps advancing the state machine. Re-check at each
    transition, the one point where the workflow actually moves.

    Two independent signals, either sufficient: a hook-sourced ledger event since
    the last transition (proof the hooks fired during THIS leg), or a fresh
    heartbeat (proof they fired recently at all; carries the future-skew bound).
    """
    wf_id = S.active_id(root)
    if not wf_id or a.to in LIVENESS_EXEMPT_STATES:
        return  # recovery/abandon exits must never be gated on liveness
    if ledger.hook_event_since_last_transition(root, wf_id):
        return
    live, why = heartbeat.status(root)
    if live:
        return

    try:
        _, st = S.load_state(root, wf_id)
        frm = st["state"]
    except GmdwError:
        frm = None

    if _affirmative(os.environ.get("GMDW_ALLOW_UNGOVERNED")) or a.allow_ungoverned:
        ledger.log(root, wf_id, "governance_liveness_bypassed", reason=why,
                   actor=a.actor, from_state=frm, to_state=a.to)
        print(f"wf: warning: {why}; advancing under the ungoverned override "
              f"(recorded in the ledger)", file=sys.stderr)
        return

    ledger.log(root, wf_id, "transition_denied", to_state=a.to, from_state=frm,
               reason=f"governance hooks are not firing in this session: {why}")
    _die("governance hooks are not firing in this session — refusing to advance "
         "the workflow.\n"
         f"  reason: {why}\n"
         "  This workflow started under enforcement, but this session is not\n"
         "  providing it: write-scoping, the push gate and artifact acceptance\n"
         "  are all absent, so advancing would record governed progress that\n"
         "  nothing governed. Relaunch Claude Code with gmdw-claude-code as the\n"
         "  project root and retry.\n"
         "  ESCALATED / FAILED / REJECTED remain reachable without hooks.\n"
         "  For legitimate non-Claude use (CI, manual ops) set\n"
         "  GMDW_ALLOW_UNGOVERNED=1 or pass --allow-ungoverned (recorded in\n"
         "  the ledger).")


def cmd_transition(a):
    root = _root()
    _liveness_preflight(root, a)
    try:
        st = S.transition(root, a.to, a.trigger, actor=a.actor,
                          reason=a.reason, detail=a.detail)
    except GmdwError as e:
        # log the denial so ping-pong attempts leave an audit trail
        try:
            wf_id, _st = S.load_state(root)
            ledger.log(root, wf_id, "transition_denied", to_state=a.to,
                       from_state=_st["state"], reason=str(e))
        except GmdwError:
            pass
        _die(str(e))
    print(json.dumps({"state": st["state"],
                      "entered_at": st["state_entered_at"]}))


def cmd_approve(a):
    """Record a human gate decision.

    This is the authority the v0.3.0 rework moved out of the model's hands. The
    `final` gate in particular is what `FINAL_APPROVAL -> APPROVED` requires:
    the Reviewer's verdict is advisory, and only the frozen artifact this writes
    — carrying `human_approved: true` and naming the exact review it signs — will
    open that edge.
    """
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))

    gate, decision, resolution = a.gate, a.decision, a.resolution
    if gate == "escalation":
        if not resolution:
            _die("escalation approval requires --resolution "
                 "redirect|override|force_approve|abandon", 2)
        if not st["escalations"] or st["escalations"][-1]["resolution"] != "pending":
            _die("no pending escalation to resolve")
        decision = "force_approved" if resolution == "force_approve" else "approved"
    elif not decision:
        _die("--decision is required for non-escalation gates", 2)

    # Default the subject to whatever this gate actually signs, so the common
    # case cannot accidentally record an approval that names nothing (and would
    # then fail the version-scoped check at the guard).
    subject = a.subject or S.approval_subject(st, gate) or ""

    res = accept.record_approval(root, st, gate=gate, decision=decision,
                                 by=a.by, subject=subject, notes=a.notes or "",
                                 resolution=resolution,
                                 overridden_findings=a.overridden_findings)
    if not res.accepted:
        _die(res.reason)
    S.save_state(root, wf_id, st)
    print(json.dumps({"gate": gate, "decision": decision,
                      "subject": subject, "artifact": res.extra["artifact"]}))


def cmd_accept(a):
    """Human recovery for a STRANDED artifact.

    An artifact an agent produced validly, but that nothing ever accepted
    (because the orchestrator died, or the session's hooks were not firing),
    leaves the workflow unable to advance: the guard wants a pointer only
    acceptance sets, and the artifact is already on disk so re-running the agent
    would collide with it.

    This accepts ONLY the artifacts the current state is waiting for, via the
    same core the orchestrator uses — identical validation, no privileged
    shortcut. It is denied by the PreToolUse gate while hooks are live (nothing
    legitimate needs it there), so it is reachable only from a genuinely
    hooks-dark session or an ordinary terminal.
    """
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))

    exp = S.expected(root, st)
    if exp is None:
        gate = S.GATE_FOR_STATE.get(st["state"])
        _die(f"state {st['state']} produces no artifact; there is nothing to "
             f"accept" + (f" (it is waiting on the '{gate}' gate — use "
                          f"`wf approve {gate}`)" if gate else ""))

    primary = exp["primary"]
    full = S.workflow_dir(root, wf_id) / primary["run_rel"]
    if not full.exists():
        _die(f"nothing to accept: {primary['run_rel']} does not exist. State "
             f"{st['state']} is waiting for {primary['artifact_type']} "
             f"v{primary['version']}; only that exact version is acceptable.")
    if ledger.is_frozen(root, wf_id, primary["run_rel"]):
        _die(f"{primary['run_rel']} is already accepted and frozen; accepted "
             f"artifacts are immutable (produce the next version instead)")

    res = accept.accept_stage(root, st, exp, actor="human_recovery", by=a.by)
    if not res.accepted:
        _die(f"refusing to accept {primary['run_rel']}: {res.reason}")

    st["counters"]["consecutive_failures"] = 0
    st["open_invocation"] = None
    S.save_state(root, wf_id, st)
    print(json.dumps({"accepted": res.extra.get("accepted", []), "by": a.by,
                      "state": st["state"]}, indent=2))


def cmd_clear_invocation(a):
    """Human recovery for an ORPHANED invocation.

    If an invocation is interrupted between the orchestrator opening it and the
    agent actually running, open_invocation dangles with no process behind it.
    That deadlocks the workflow completely: guard() refuses EVERY transition
    while an invocation is open — including ESCALATED, the documented escape —
    and single-flight refuses every new invocation. The lock outlives the thing
    it was protecting.

    This releases that lock and nothing else: no counters, no pointers, no
    acceptance. consecutive_failures deliberately survives, so clearing cannot be
    used to dodge the two-failure escalation limit.
    """
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))

    inv = st.get("open_invocation")
    if not inv:
        _die("no open invocation to clear; nothing to do")

    summary = {"agent": inv.get("agent"), "expected_type": inv.get("expected_type"),
               "version": inv.get("version")}
    st["open_invocation"] = None
    S.save_state(root, wf_id, st)
    ledger.log(root, wf_id, "invocation_cleared", actor="human_recovery",
               by=a.by, **summary)
    print(json.dumps({"cleared": summary, "by": a.by, "state": st["state"]}))


def cmd_validate(a):
    """Validate an artifact against its contract.

    Markdown artifacts go through gmdw.parsers; the approval record — the one
    artifact still authored as JSON, because a machine writes it — goes through
    the JSON-Schema subset validator.
    """
    root = _root()
    p = Path(a.path)
    if not p.exists():
        _die(f"file not found: {a.path}", 2)

    if a.type == "approval":
        from gmdw import schemas
        try:
            artifact = json.loads(p.read_text(encoding="utf-8"))
        except json.JSONDecodeError as e:
            _die(f"not valid JSON: {e}")
        errs = schemas.validate_artifact(root, artifact, "approval")
    else:
        wf_id = a.workflow or S.active_id(root) or ""
        version = a.artifact_version
        if version is None:
            import re as _re
            m = _re.search(r"_v(\d+)", p.name) or _re.search(r"_v(\d+)/", str(p))
            version = int(m.group(1)) if m else 1
        errs = parsers.validate_artifact(p.read_text(encoding="utf-8"), a.type,
                                         workflow_id=wf_id, version=version)

    if errs:
        print(json.dumps({"valid": False, "errors": errs}, indent=2))
        sys.exit(1)
    print(json.dumps({"valid": True}))


def cmd_close(a):
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    try:
        print(json.dumps(S.close_workflow(root, wf_id, st)))
    except GmdwError as e:
        _die(str(e))


# ----------------------------------------------------------------------- #

def main():
    ap = argparse.ArgumentParser(prog="wf", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"GMDW wf {GMDW_VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="create a workflow without driving it")
    p.add_argument("--request", required=True, help="path to request file, or - for stdin")
    p.add_argument("--title", default=None)
    p.add_argument("--by", default=os.environ.get("USER", "unknown"))
    p.add_argument("--profile", default=None, help="policy profile override")
    p.add_argument("--auto-approve", action="store_true", dest="auto_approve",
                   help="waive the plan and final human gates (trivial route + "
                        "permitting profile only; never the deployment gate)")
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("status", help="show workflow status")
    p.add_argument("--workflow", default=None)
    p.add_argument("--json", action="store_true", help="compact single-line JSON")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("expected", help="what the current state is waiting for")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_expected)

    p = sub.add_parser("doctor", help="read-only: is the enforcement plane wired "
                                      "up and live? (no side effects)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("transition", help="request a state transition")
    p.add_argument("to", choices=S.STATES)
    p.add_argument("--trigger", required=True,
                   help="artifact ref / approval ref that justifies the transition")
    p.add_argument("--actor", default="orchestrator",
                   choices=["orchestrator", "hook", "human"])
    p.add_argument("--reason", default=None,
                   choices=[None, "revision_limit", "reject_verdict", "agent_blocked",
                            "budget", "limit", "integrity_violation",
                            "stale_workspace", "other"])
    p.add_argument("--detail", default=None)
    p.add_argument("--allow-ungoverned", action="store_true",
                   dest="allow_ungoverned",
                   help="advance even though the governance hooks are not firing "
                        "in this session (audited; for CI / manual ops)")
    p.set_defaults(fn=cmd_transition)

    p = sub.add_parser("approve", help="record a human gate decision")
    p.add_argument("gate", choices=GATES)
    p.add_argument("--decision", default=None,
                   choices=["approved", "changes_requested", "rejected",
                            "force_approved"])
    p.add_argument("--by", required=True)
    p.add_argument("--subject", default=None,
                   help="artifact being approved (defaults to the current "
                        "plan/review for the plan/final gates)")
    p.add_argument("--notes", default=None)
    p.add_argument("--resolution", default=None,
                   choices=["redirect", "override", "force_approve", "abandon"])
    p.add_argument("--overridden-findings", nargs="*", default=None,
                   dest="overridden_findings")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_approve)

    p = sub.add_parser("accept", help="human recovery: accept the stranded, "
                                      "validly-produced artifacts of the "
                                      "current stage")
    p.add_argument("--by", required=True, help="human accountable for the recovery")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_accept)

    p = sub.add_parser("clear-invocation",
                       help="human recovery: release an orphaned open_invocation")
    p.add_argument("--by", required=True, help="human accountable for the recovery")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_clear_invocation)

    p = sub.add_parser("validate", help="validate an artifact against its contract")
    p.add_argument("path")
    p.add_argument("--type", required=True,
                   choices=sorted(set(parsers.ARTIFACT_SPEC) | {"approval"}))
    p.add_argument("--workflow", default=None,
                   help="workflow id the envelope must name (default: ACTIVE)")
    p.add_argument("--artifact-version", type=int, default=None,
                   dest="artifact_version",
                   help="version the envelope must declare (default: from the "
                        "filename)")
    p.set_defaults(fn=cmd_validate)

    p = sub.add_parser("close", help="finalize a terminal workflow")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_close)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
