#!/usr/bin/env python3
"""wf — GMDW workflow CLI. The only legal mutator of state.json.

Commands:
  init        create a workflow (state=RECEIVED, sets ACTIVE, pins the policy)
  status      show the active workflow's state, counters, budget
  expected    show what artifact/agent the current state is waiting for
  doctor      read-only preflight: are the governance hooks live this session?
  transition  request a state transition (table + guard validated)
  approve     record a human gate decision as an approval artifact
  accept      human recovery: accept a stranded, validly-produced artifact
  clear-invocation  human recovery: release an orphaned open_invocation
  validate    validate an artifact file against its schema
  close       finalize a terminal workflow (tamper check, index, clear ACTIVE)

The two recovery commands exist ONLY for a session whose governance hooks are
not firing (nothing else can accept an artifact or release the single-flight
lock there). While the hooks ARE live the PreToolUse gate denies them, so they
cannot be used to bypass invocation gating from inside a governed session.

Exit codes: 0 ok, 1 governance rejection / validation failure, 2 usage error.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
_FALLBACK_ROOT = _HERE.parent.parent  # repo root when invoked in place
sys.path.insert(0, str(_FALLBACK_ROOT / ".claude" / "hooks"))

from gmdw import __version__ as GMDW_VERSION  # noqa: E402
from gmdw import accept, heartbeat, ledger, policy, schemas  # noqa: E402
from gmdw import state as S               # noqa: E402
from gmdw.state import GmdwError          # noqa: E402

# Transitions that must stay reachable when the enforcement plane is dark:
# they are how a stuck or ungoverned workflow is abandoned or handed to a human.
LIVENESS_EXEMPT_STATES = ("ESCALATED", "FAILED", "REJECTED")

# The canonical bypass env var (ADR-001). Read with an AFFIRMATIVE-ONLY check:
# a bypass that treats GMDW_ALLOW_UNGOVERNED=0 as "on" would silently disable
# governance on a stray assignment, which is the wrong way for this to fail.
_AFFIRMATIVE = {"1", "true", "yes", "on"}


def _affirmative(value: str | None) -> bool:
    return (value or "").strip().lower() in _AFFIRMATIVE


def _root():
    try:
        return S.find_root(os.getcwd())
    except GmdwError:
        return _FALLBACK_ROOT


def _die(msg: str, code: int = 1):
    print(f"wf: error: {msg}", file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------------- #

def cmd_init(a):
    root = _root()
    if a.request == "-":
        text = sys.stdin.read()
    else:
        p = Path(a.request)
        if not p.exists():
            _die(f"request file not found: {a.request}", 2)
        text = p.read_text(encoding="utf-8")
    if not text.strip():
        _die("request is empty", 2)
    title = a.title or text.strip().splitlines()[0][:120]

    # Governance-liveness preflight (ADR-001 Phase 1). GMDW's guarantees are
    # enforced by hooks that exist only when Claude Code loaded THIS project's
    # settings. If they are not firing in this session, creating a workflow
    # would advance state with no enforcement (ungoverned writes/invocations on
    # the trivial route, or a deadlock at the first hook-owned acceptance).
    # Refuse fast with an actionable message rather than fail later.
    live, why = heartbeat.status(root)
    # GMDW_ALLOW_UNGOVERNED is the canonical name (honored at init and at
    # transition) and is affirmative-only. GMDW_ALLOW_UNGOVERNED_INIT is the
    # Phase-1 name, kept working here for backward compatibility with its
    # original loose truthiness.
    bypass = (os.environ.get("GMDW_ALLOW_UNGOVERNED_INIT") or
              _affirmative(os.environ.get("GMDW_ALLOW_UNGOVERNED")))
    if not live and not bypass:
        _die("governance hooks are not active in this session — refusing to "
             "start a workflow.\n"
             f"  reason: {why}\n"
             "  Enforcement (invocation gating, write-scoping, budgets, artifact\n"
             "  acceptance) is provided by hooks registered in this project's\n"
             "  .claude/settings.json. Launch Claude Code with gmdw-claude-code as\n"
             "  the project root and retry.\n"
             "  For legitimate non-Claude use (CI, manual ops) set\n"
             "  GMDW_ALLOW_UNGOVERNED=1 to override (recorded in the ledger).")

    try:
        wf_id = S.create_workflow(root, text, title, a.by, a.profile)
    except GmdwError as e:
        _die(str(e))

    if not live:  # bypass was set: record the ungoverned start in the audit trail
        ledger.log(root, wf_id, "governance_liveness_bypassed", reason=why, by=a.by)
        print(f"wf: warning: {why}; proceeding under GMDW_ALLOW_UNGOVERNED_INIT "
              f"(recorded in the ledger)", file=sys.stderr)

    print(json.dumps({"workflow_id": wf_id, "state": "RECEIVED",
                      "run_dir": f".workflow/runs/{wf_id}"}))


def cmd_status(a):
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    out = {
        "workflow_id": wf_id,
        "title": st["workflow"]["title"],
        "state": st["state"],
        "route": st["route"],
        "flags": st["flags"],
        "counters": st["counters"],
        "limits": st["limits"],
        "budget": st["budget"],
        "current": st["current"],
        "plan_approved": st["plan_approved"],
        "approvals": [{k: v for k, v in ap.items() if k != "notes"}
                      for ap in st["approvals"]],
        "escalations": st["escalations"],
        "open_invocation": st["open_invocation"],
        "policy_profile": st["policy"]["profile_name"],
    }
    print(json.dumps(out, indent=None if a.json else 2))


def cmd_expected(a):
    root = _root()
    try:
        _, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    exp = S.expected(root, st)
    if exp is None:
        print(json.dumps({"state": st["state"], "expected": None,
                          "note": "no artifact is produced in this state"}))
    else:
        print(json.dumps(exp))


def cmd_doctor(a):
    """Read-only preflight: is the GMDW enforcement plane actually live in THIS
    session? Creates and mutates NOTHING (no state.json, ledger, ACTIVE, or run
    file), so it is safe to run anytime, including before `init`.

    It can report liveness despite writing nothing because of self-attestation:
    run via Bash while the hooks are live, the PreToolUse gate fires on that very
    Bash invocation and refreshes the heartbeat immediately before this reads it —
    the same trick `wf init` relies on. A hooks-dark session gets no such refresh,
    so the heartbeat is stale or absent and the plane reports as down.

    Exit 0 when the hooks are live, 1 when they are not, so it is usable as a
    scriptable preflight (e.g. `wf doctor && wf init --request ...`).
    """
    root = _root()
    live, why = heartbeat.status(root)
    active = S.active_id(root)
    if a.json:
        print(json.dumps({"hooks_live": live, "reason": why,
                          "active_workflow": active}))
    else:
        print("✅ governance hooks are LIVE" if live
              else "❌ governance hooks are NOT firing in this session")
        print(f"   {why}")
        print(f"   active workflow: {active or 'none'}")
        if not live:
            print("   → you are likely not rooted in the gmdw-claude-code project. "
                  "Launch Claude Code with this repo as the project root "
                  "(see docs/GETTING_STARTED.md), then retry.")
    sys.exit(0 if live else 1)


def _liveness_preflight(root, a):
    """Refuse a mid-run transition when the enforcement plane is dark
    (ADR-001 Phase 2).

    `wf init` proves the hooks were live at the START of a workflow, but the
    session can lose them afterwards (a resumed run, a session rooted elsewhere,
    a settings change) — and from then on nothing gates invocations, scopes
    writes, or accepts artifacts, while `wf` happily keeps advancing the state
    machine. Re-check at each transition, the one point where the workflow
    actually moves.

    Two independent signals, either sufficient: a hook-sourced ledger event since
    the last transition (proof the hooks fired during THIS leg), or a fresh
    heartbeat (proof they fired recently at all; carries the future-skew bound).
    """
    wf_id = S.active_id(root)
    if not wf_id or a.to in LIVENESS_EXEMPT_STATES:
        return  # recovery/abandon exits must never be gated on liveness
    if ledger.hook_event_since_last_transition(root, wf_id):
        return
    live, why = heartbeat.status(root)
    if live:
        return

    try:
        _, st = S.load_state(root, wf_id)
        frm = st["state"]
    except GmdwError:
        frm = None

    if _affirmative(os.environ.get("GMDW_ALLOW_UNGOVERNED")) or a.allow_ungoverned:
        ledger.log(root, wf_id, "governance_liveness_bypassed", reason=why,
                   actor=a.actor, from_state=frm, to_state=a.to)
        print(f"wf: warning: {why}; advancing under the ungoverned override "
              f"(recorded in the ledger)", file=sys.stderr)
        return

    ledger.log(root, wf_id, "transition_denied", to_state=a.to, from_state=frm,
               reason=f"governance hooks are not firing in this session: {why}")
    _die("governance hooks are not firing in this session — refusing to advance "
         "the workflow.\n"
         f"  reason: {why}\n"
         "  This workflow started under enforcement, but this session is not\n"
         "  providing it: invocation gating, write-scoping, budgets and artifact\n"
         "  acceptance are all absent, so advancing would record governed\n"
         "  progress that nothing governed. Relaunch Claude Code with\n"
         "  gmdw-claude-code as the project root and retry.\n"
         "  ESCALATED / FAILED / REJECTED remain reachable without hooks.\n"
         "  For legitimate non-Claude use (CI, manual ops) set\n"
         "  GMDW_ALLOW_UNGOVERNED=1 or pass --allow-ungoverned (recorded in\n"
         "  the ledger).")


def cmd_transition(a):
    root = _root()
    _liveness_preflight(root, a)
    try:
        st = S.transition(root, a.to, a.trigger, actor=a.actor,
                          reason=a.reason, detail=a.detail)
    except GmdwError as e:
        # log the denial so ping-pong attempts leave an audit trail
        try:
            wf_id, _st = S.load_state(root)
            ledger.log(root, wf_id, "transition_denied", to_state=a.to,
                       from_state=_st["state"], reason=str(e))
        except GmdwError:
            pass
        _die(str(e))
    print(json.dumps({"state": st["state"],
                      "entered_at": st["state_entered_at"]}))


def cmd_approve(a):
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    now = S.utcnow()
    gate, decision, resolution = a.gate, a.decision, a.resolution

    if gate == "escalation":
        if not resolution:
            _die("escalation approval requires --resolution "
                 "redirect|override|force_approve|abandon", 2)
        if not st["escalations"] or st["escalations"][-1]["resolution"] != "pending":
            _die("no pending escalation to resolve")
        decision = "force_approved" if resolution == "force_approve" else "approved"
        rel = f"artifacts/approvals/escalation_{len(st['escalations'])}.json"
    else:
        if not decision:
            _die("--decision is required for non-escalation gates", 2)
        rel = f"artifacts/approvals/{gate}_approval.json"

    version = 1 + sum(1 for ap in st["approvals"] if ap["gate"] == gate)
    artifact = {
        "artifact_type": "approval",
        "workflow_id": wf_id,
        "version": version,
        "produced_by": "human",
        "input_artifact_refs": [a.subject] if a.subject else [],
        "created_at": now,
        "status": "complete",
        "gate": gate,
        "decision": decision,
        "by": a.by,
        "at": now,
        "subject_ref": a.subject or "",
        "notes": a.notes or "",
    }
    if resolution:
        artifact["resolution"] = resolution
    if a.overridden_findings:
        artifact["overridden_findings"] = a.overridden_findings

    errs = schemas.validate_artifact(root, artifact, "approval")
    if errs:
        _die("approval artifact invalid: " + "; ".join(errs))

    full = S.workflow_dir(root, wf_id) / rel
    if full.exists():
        _die(f"approval artifact already exists: {rel} (approvals are immutable)")
    S.atomic_write_json(full, artifact)
    S.freeze_artifact(root, wf_id, rel, st["state"])

    st["approvals"].append({"gate": gate, "decision": decision, "by": a.by,
                            "at": now, "artifact_ref": rel,
                            "notes": a.notes or ""})
    if gate == "plan" and decision in ("approved", "force_approved"):
        st["plan_approved"] = True
    if gate == "escalation":
        st["escalations"][-1]["resolution"] = resolution
        st["escalations"][-1]["resolved_at"] = now
    S.save_state(root, wf_id, st)
    ledger.log(root, wf_id, "human_approval", gate=gate, decision=decision,
               by=a.by, resolution=resolution, artifact=rel)
    print(json.dumps({"gate": gate, "decision": decision, "artifact": rel}))


def cmd_accept(a):
    """Human recovery for a STRANDED artifact (ADR-001 Phase 2).

    An artifact that a subagent produced validly, but that no SubagentStop hook
    ever accepted (because the hooks were not firing), leaves the workflow unable
    to advance: the guard wants a pointer only acceptance sets, and the artifact
    is already on disk so re-running the agent would collide with it.

    This accepts ONLY the exact artifact the current state is waiting for, via
    the same core the hook uses — identical validation, no privileged shortcut.
    It is denied by the PreToolUse gate while hooks are live (nothing legitimate
    needs it there), so it is reachable only from a genuinely hooks-dark session.
    """
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))

    exp = S.expected(root, st)
    if exp is None:
        _die(f"state {st['state']} produces no artifact; there is nothing to "
             f"accept (recovery here is 'wf approve' or a transition)")
    atype, version = exp["artifact_type"], exp["version"]
    run_rel = S.artifact_relpath(atype, version)
    full = S.workflow_dir(root, wf_id) / run_rel

    if not full.exists():
        _die(f"nothing to accept: {run_rel} does not exist. State {st['state']} "
             f"is waiting for {atype} v{version}; only that exact version is "
             f"acceptable.")
    if ledger.is_frozen(root, wf_id, run_rel):
        _die(f"{run_rel} is already accepted and frozen; accepted artifacts are "
             f"immutable (produce the next version instead)")

    res = accept.accept_artifact(root, st, atype, version,
                                 actor="human_recovery", by=a.by)
    if not res.accepted:
        _die(f"refusing to accept {run_rel}: {res.reason}")

    # The core advanced the pointer, froze the artifact and logged acceptance.
    # Close out the invocation plane exactly as the hook would.
    st["counters"]["consecutive_failures"] = 0
    st["open_invocation"] = None
    S.save_state(root, wf_id, st)
    print(json.dumps({"accepted": atype, "version": version, "path": run_rel,
                      "by": a.by, "state": st["state"]}))


def cmd_clear_invocation(a):
    """Human recovery for an ORPHANED invocation (ADR-001 Phase 2).

    If an invocation is interrupted between the gate opening it and a subagent
    actually running, open_invocation dangles with no process behind it. That
    deadlocks the workflow completely: guard() refuses EVERY transition while an
    invocation is open — including ESCALATED, the documented escape — and
    single-flight refuses every new invocation. The lock outlives the thing it
    was protecting.

    This releases that lock and nothing else: no counters, no pointers, no
    acceptance. consecutive_failures deliberately survives, so clearing cannot be
    used to dodge the two-failure escalation limit. Like 'wf accept' it is denied
    by the gate while hooks are live (a live session's in-flight lock is real).
    """
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))

    inv = st.get("open_invocation")
    if not inv:
        _die("no open invocation to clear; nothing to do")

    summary = {"agent": inv.get("agent"), "expected_type": inv.get("expected_type"),
               "version": inv.get("version")}
    st["open_invocation"] = None
    S.save_state(root, wf_id, st)
    ledger.log(root, wf_id, "invocation_cleared", actor="human_recovery",
               by=a.by, **summary)
    print(json.dumps({"cleared": summary, "by": a.by, "state": st["state"]}))


def cmd_validate(a):
    root = _root()
    p = Path(a.path)
    if not p.exists():
        _die(f"file not found: {a.path}", 2)
    try:
        artifact = json.loads(p.read_text(encoding="utf-8"))
    except json.JSONDecodeError as e:
        _die(f"not valid JSON: {e}")
    errs = schemas.validate_artifact(root, artifact, a.type)
    if errs:
        print(json.dumps({"valid": False, "errors": errs}, indent=2))
        sys.exit(1)
    print(json.dumps({"valid": True}))


def cmd_close(a):
    root = _root()
    try:
        wf_id, st = S.load_state(root, a.workflow)
    except GmdwError as e:
        _die(str(e))
    if st["state"] not in S.TERMINAL:
        _die(f"cannot close: state {st['state']} is not terminal "
             f"({sorted(S.TERMINAL)})")
    mismatches = ledger.verify(root, wf_id)
    if mismatches:
        ledger.log(root, wf_id, "integrity_violation", detail=mismatches,
                   phase="close")
        _die(f"tamper check failed; refusing to close: {mismatches}")

    idx_p = Path(root) / ".workflow" / "index.json"
    idx = json.loads(idx_p.read_text(encoding="utf-8")) if idx_p.exists() else {}
    idx[wf_id] = {
        "title": st["workflow"]["title"],
        "state": st["state"],
        "created_at": st["workflow"]["created_at"],
        "closed_at": S.utcnow(),
        "cost_usd_estimate": st["budget"]["cost_usd_estimate"],
        "tokens": st["budget"]["tokens_consumed_estimate"],
    }
    S.atomic_write_json(idx_p, idx)

    active = Path(root) / ".workflow" / "ACTIVE"
    if active.exists() and active.read_text(encoding="utf-8").strip() == wf_id:
        active.unlink()
    ledger.log(root, wf_id, "workflow_closed", final_state=st["state"])
    print(json.dumps({"closed": wf_id, "final_state": st["state"]}))


# ----------------------------------------------------------------------- #

def main():
    ap = argparse.ArgumentParser(prog="wf", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"GMDW wf {GMDW_VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init", help="create a workflow")
    p.add_argument("--request", required=True, help="path to request file, or - for stdin")
    p.add_argument("--title", default=None)
    p.add_argument("--by", default=os.environ.get("USER", "unknown"))
    p.add_argument("--profile", default=None, help="policy profile override")
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("status", help="show workflow status")
    p.add_argument("--workflow", default=None)
    p.add_argument("--json", action="store_true", help="compact single-line JSON")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("expected", help="what the current state is waiting for")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_expected)

    p = sub.add_parser("doctor", help="read-only: are the governance hooks live "
                                      "in this session? (no side effects)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("transition", help="request a state transition")
    p.add_argument("to", choices=S.STATES)
    p.add_argument("--trigger", required=True,
                   help="artifact ref / approval ref that justifies the transition")
    p.add_argument("--actor", default="orchestrator",
                   choices=["orchestrator", "hook", "human"])
    p.add_argument("--reason", default=None,
                   choices=[None, "revision_limit", "reject_verdict", "agent_blocked",
                            "budget", "integrity_violation", "stale_workspace", "other"])
    p.add_argument("--detail", default=None)
    p.add_argument("--allow-ungoverned", action="store_true",
                   dest="allow_ungoverned",
                   help="advance even though the governance hooks are not firing "
                        "in this session (audited; for CI / manual ops)")
    p.set_defaults(fn=cmd_transition)

    p = sub.add_parser("approve", help="record a human gate decision")
    p.add_argument("gate", choices=["plan", "architecture", "deployment",
                                    "escalation", "route_downgrade"])
    p.add_argument("--decision", default=None,
                   choices=["approved", "changes_requested", "rejected",
                            "force_approved"])
    p.add_argument("--by", required=True)
    p.add_argument("--subject", default=None, help="artifact being approved")
    p.add_argument("--notes", default=None)
    p.add_argument("--resolution", default=None,
                   choices=["redirect", "override", "force_approve", "abandon"])
    p.add_argument("--overridden-findings", nargs="*", default=None,
                   dest="overridden_findings")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_approve)

    p = sub.add_parser("accept", help="human recovery: accept a stranded, "
                                      "validly-produced artifact (hooks-dark "
                                      "sessions only)")
    p.add_argument("--by", required=True, help="human accountable for the recovery")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_accept)

    p = sub.add_parser("clear-invocation",
                       help="human recovery: release an orphaned open_invocation "
                            "(hooks-dark sessions only)")
    p.add_argument("--by", required=True, help="human accountable for the recovery")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_clear_invocation)

    p = sub.add_parser("validate", help="validate an artifact against its schema")
    p.add_argument("path")
    p.add_argument("--type", required=True, choices=sorted(schemas.SCHEMA_FOR_TYPE))
    p.set_defaults(fn=cmd_validate)

    p = sub.add_parser("close", help="finalize a terminal workflow")
    p.add_argument("--workflow", default=None)
    p.set_defaults(fn=cmd_close)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
