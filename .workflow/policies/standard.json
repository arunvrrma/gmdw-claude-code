{
  "name": "standard",
  "description": "Default GMDW governance profile. Three agents, both human gates blocking on medium and full, waivable only on the trivial route.",
  "routing": {
    "t1": 3,
    "t2": 8,
    "flag_rules": {
      "security": { "dimension": "security", "min": 2 },
      "data_model": { "dimension": "data_model", "min": 2 }
    },
    "trivial_max_files": 3
  },
  "limits": {
    "max_plan_revisions": 2,
    "max_impl_revisions": 3,
    "max_review_cycles": 6,
    "max_agent_invocations": 8,
    "per_invocation_timeout_min": 30,
    "wall_clock_hours": 12
  },
  "budget": {
    "token_budget": 2500000,
    "soft_threshold_pct": 80,
    "cost_ceiling_usd": 12
  },
  "gates": {
    "plan_approval": { "trivial": "off", "medium": "blocking", "full": "blocking" },
    "final_approval": { "trivial": "off", "medium": "blocking", "full": "blocking" },
    "architecture_approval": { "enabled": true,
                               "trigger": { "dimension": "architectural", "min": 2 } },
    "deployment_approval": "blocking"
  },
  "security": {
    "plan_review_trigger": 2,
    "code_review_trigger": 2,
    "always_review_plans": false
  },
  "verification": {
    "rerun_tests": true,
    "path_existence_checks": true,
    "tamper_check_on_finalize": true
  },
  "models": {
    "analyst-planner": { "model": "sonnet", "effort": "high" },
    "implementor":     { "model": "opus",   "effort": "high" },
    "reviewer":        { "model": "sonnet", "effort": "high" },
    "escalate_implementor_after_revisions": 1
  },
  "finalization": { "mode": "pr", "require_ci_green": false }
}
