{
  "name": "strict",
  "description": "For regulated or production-critical repositories. Every human gate is blocking on every route, so --auto-approve can never apply; security review always runs; humans see failures sooner (fewer automated retries). Strictness costs tokens — the budget is honest about it.",
  "routing": {
    "t1": 3,
    "t2": 8,
    "flag_rules": {
      "security": { "dimension": "security", "min": 1 },
      "data_model": { "dimension": "data_model", "min": 1 }
    },
    "trivial_max_files": 1
  },
  "limits": {
    "max_plan_revisions": 2,
    "max_impl_revisions": 2,
    "max_review_cycles": 6,
    "max_agent_invocations": 10,
    "per_invocation_timeout_min": 40,
    "wall_clock_hours": 24
  },
  "budget": {
    "token_budget": 5000000,
    "soft_threshold_pct": 70,
    "cost_ceiling_usd": 30
  },
  "gates": {
    "plan_approval": { "trivial": "blocking", "medium": "blocking", "full": "blocking" },
    "final_approval": { "trivial": "blocking", "medium": "blocking", "full": "blocking" },
    "architecture_approval": { "enabled": true,
                               "trigger": { "dimension": "architectural", "min": 1 } },
    "deployment_approval": "blocking"
  },
  "security": {
    "plan_review_trigger": 1,
    "code_review_trigger": 1,
    "always_review_plans": true
  },
  "verification": {
    "rerun_tests": true,
    "path_existence_checks": true,
    "tamper_check_on_finalize": true
  },
  "models": {
    "analyst-planner": { "model": "opus", "effort": "high" },
    "implementor":     { "model": "opus", "effort": "high" },
    "reviewer":        { "model": "opus", "effort": "xhigh" },
    "escalate_implementor_after_revisions": 0
  },
  "finalization": { "mode": "pr", "require_ci_green": true }
}
