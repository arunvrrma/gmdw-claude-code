{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmdw.local/schemas/classification.schema.json",
  "title": "GMDW task classification",
  "type": "object",
  "required": ["scores", "total", "override_flags", "route", "evidence"],
  "properties": {
    "scores": {
      "type": "object",
      "required": ["files_impacted", "architectural", "security", "data_model",
                   "integrations", "testing"],
      "properties": {
        "files_impacted": { "type": "integer", "minimum": 0, "maximum": 3 },
        "architectural":  { "type": "integer", "minimum": 0, "maximum": 3 },
        "security":       { "type": "integer", "minimum": 0, "maximum": 3 },
        "data_model":     { "type": "integer", "minimum": 0, "maximum": 3 },
        "integrations":   { "type": "integer", "minimum": 0, "maximum": 3 },
        "testing":        { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "total": { "type": "integer", "minimum": 0, "maximum": 18 },
    "override_flags": {
      "type": "array",
      "items": { "enum": ["security", "data_model"] }
    },
    "route": { "enum": ["trivial", "medium", "full"] },
    "route_rationale": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
