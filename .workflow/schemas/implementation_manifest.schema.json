{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmdw.local/schemas/implementation_manifest.schema.json",
  "title": "GMDW implementation manifest",
  "type": "object",
  "required": ["plan_ref", "base_commit", "changes", "tests", "milestone_status",
               "deviations"],
  "properties": {
    "plan_ref": { "type": ["string", "null"] },
    "base_commit": { "type": "string" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "action", "summary"],
        "properties": {
          "path": { "type": "string" },
          "action": { "enum": ["created", "modified", "deleted"] },
          "summary": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "object",
      "required": ["added", "command", "result"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "command": { "type": "string" },
        "result": { "enum": ["pass", "fail", "not_run"] },
        "output_ref": { "type": "string" }
      }
    },
    "milestone_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["milestone_id", "status"],
        "properties": {
          "milestone_id": { "type": "string" },
          "status": { "enum": ["done", "partial", "skipped"] },
          "note": { "type": "string" }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why", "requires_approval"],
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" },
          "requires_approval": { "type": "boolean" }
        }
      }
    }
  }
}
