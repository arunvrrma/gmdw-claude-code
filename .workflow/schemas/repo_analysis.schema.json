{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmdw.local/schemas/repo_analysis.schema.json",
  "title": "GMDW repository analysis",
  "type": "object",
  "required": ["stack", "relevant_modules", "conventions", "test_infrastructure",
               "security_surfaces", "unverified"],
  "properties": {
    "stack": {
      "type": "object",
      "required": ["languages"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "package_manager": { "type": "string" }
      }
    },
    "relevant_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "test_infrastructure": {
      "type": "object",
      "required": ["test_command"],
      "properties": {
        "test_command": { "type": "string" },
        "layout": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "data_model_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "security_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "integration_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "evidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "unverified": { "type": "array", "items": { "type": "string" } }
  }
}
