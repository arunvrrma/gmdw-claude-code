{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmdw.local/schemas/review.schema.json",
  "title": "GMDW review (plan-reviewer and code-reviewer)",
  "type": "object",
  "required": ["mode", "subject_ref", "verdict", "verdict_rationale", "findings",
               "acceptance_criteria"],
  "properties": {
    "mode": { "enum": ["plan", "code"] },
    "subject_ref": { "type": "string" },
    "verdict": { "enum": ["approve", "revise", "reject"] },
    "verdict_rationale": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "location", "description",
                     "recommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "category": {
            "enum": ["correctness", "security", "maintainability", "scope",
                     "testing", "performance", "feasibility", "completeness"]
          },
          "severity": { "enum": ["blocker", "major", "minor", "info"] },
          "location": { "type": "string" },
          "description": { "type": "string" },
          "recommendation": { "type": "string" },
          "confidence": { "enum": ["low", "medium", "high"] },
          "resolves_prior_finding": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "fail", "not_verifiable"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "security_observations": { "type": "array", "items": { "type": "string" } }
  }
}
